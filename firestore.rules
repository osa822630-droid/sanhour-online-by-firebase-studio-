rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }

    // ✅ Fix #13: هوية التطبيق مقابل هوية Firebase Auth.
    // الدخول التجريبي (Mock Login) يستخدم جلسة Firebase مجهولة (anonymous)
    // فقط لتلبية isAuth()، وهويّتها (request.auth.uid) عشوائية ولا تطابق
    // معرّف مستخدم التطبيق (mock_admin / mock_merchant / mock_user ...).
    // لذلك معرّف التطبيق (appUid) يُحسب هكذا:
    //   • جلسة حقيقية (Phone Auth وغيرها): appUid == request.auth.uid.
    //   • جلسة مجهولة (mock): appUid يُقرأ من وثيقة الربط
    //     auth_sessions/{request.auth.uid} التي يكتبها AuthProvider عند الدخول.
    // كل شروط الملكية والأدوار تمرّ عبر appUid() وليس request.auth.uid مباشرةً.
    // ⚠️ وثيقة الربط يكتبها العميل نفسه (الدخول التجريبي بلا تحقق خادمي أصلاً)،
    // فهذا مقبول فقط ما دام الـ mock في مرحلة الاختبار. قبل الإطلاق الرسمي مع
    // Phone Auth: احذف فرع الجلسات المجهولة من appUid() وبلوك auth_sessions.
    function isAnonymousSession() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function appUid() {
      return isAnonymousSession()
        ? get(/databases/$(database)/documents/auth_sessions/$(request.auth.uid)).data.appUserId
        : request.auth.uid;
    }
    function isOwner(uid) { return isAuth() && appUid() == uid; }
    // ✅ Fix #17: جلسة بهوية معروفة (بدون اشتراط دور) = جلسة حقيقية، أو جلسة
    // Mock مجهولة لها وثيقة ربط في auth_sessions. الجلسة المجهولة "العارية" لا.
    function hasSessionIdentity() {
      return isAuth()
        && (!isAnonymousSession()
          || exists(/databases/$(database)/documents/auth_sessions/$(request.auth.uid)));
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(appUid())).data;
    }
    function isAdmin() {
      return isAuth() && getUserData().userType in ['admin', 'super_admin'];
    }
    function isModerator() {
      return isAuth() && getUserData().userType in ['admin', 'super_admin', 'moderator'];
    }
    function isMerchant() {
      return isAuth() && getUserData().userType == 'merchant';
    }
    function isShopOwner(shopId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == appUid();
    }
    // ✅ Fix #15: بيانات طلب خدمة — لتحديد صاحب الطلب/حالته في قواعد service_bids
    function serviceRequestData(requestId) {
      return get(/databases/$(database)/documents/service_requests/$(requestId)).data;
    }
    function notDeleted() { return resource.data.isDeleted != true; }
    function notSuspended() { return resource.data.isSuspended != true; }

    // ✅ Fix #20: عدّادات إحصائيات المحل اليومية (shops/{id}/daily_stats/{يوم}).
    // StatsService يكتب لكل زائر بـ set(merge: true) و FieldValue.increment(1)،
    // وفي كل كتابة عدّاد واحد فقط: views (ومعه date) أو phoneClicks أو whatsappClicks
    // أو facebookClicks / instagramClicks / tiktokClicks / telegramClicks.
    // request.resource.data هي القيمة النهائية بعد تطبيق الـ increment، فنقارنها
    // بالقيمة الحالية + 1: لا يقدر أحد يكتب رقماً اعتباطياً، ولا يمسّ عدّاداً غير
    // اللي يزيده، ولا يمسّ حقلاً خارج القائمة.
    //   • statCreated(f): مستند اليوم لم يكن موجوداً → عدّاد واحد = 1 (+ date اختياري).
    //   • statBumped(f): المستند موجود → العدّاد f زاد 1 بالضبط، و date يُضاف فقط
    //     لو كان غايباً (مستند اتنشأ أول مرة بعدّاد ضغطات قبل أول زيارة).
    function statCreated(f) {
      return request.resource.data.keys().hasOnly([f, 'date'])
        && f in request.resource.data
        && request.resource.data[f] == 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }
    function statBumped(f) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly([f])
          || (changed.hasOnly([f, 'date']) && !('date' in resource.data)))
        && request.resource.data[f] == (f in resource.data ? resource.data[f] : 0) + 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      // ✅ Fix #18: أولوية المعاملات — && أقوى من ||، فالصيغة القديمة كانت تُقرأ
      //   (isOwner && بلا userType) || (userType in [customer, merchant])
      // والفرع الثاني بلا أي فحص هوية (ولا حتى isAuth): أي طلب — بل وبلا جلسة
      // Firebase أصلاً — كان يقدر ينشئ users/{أي معرّف} بـ userType: merchant.
      // الآن الملكية شرط في الحالتين بالأقواس: صاحب الحساب وحده ينشئ مستنده
      // (appUid() == userId)، وبلا حقل userType أو بنوع customer/merchant فقط.
      // admin / moderator لا تُنشأ من العميل أبداً (users/mock_admin من الـ console).
      allow create: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['userType'])
          || request.resource.data.userType in ['customer', 'merchant']);
      allow update: if isOwner(userId)
        // ✅ Fix #135: منع self-escalation إلى admin/moderator
        && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']))
        || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Favorites sub-collection
      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Auth Sessions (ربط الجلسة المجهولة بهوية الـ mock) ─────────────────────
    // ✅ Fix #13: وثيقة واحدة لكل جلسة Firebase مجهولة، معرّفها = request.auth.uid
    // وفيها appUserId (معرّف مستخدم التطبيق). تُقرأ من دالة appUid() أعلاه.
    // الجلسة تكتب/تقرأ/تحذف وثيقتها هي فقط، ولا أحد غيرها يقدر.
    match /auth_sessions/{sessionId} {
      allow read, delete: if isAuth() && request.auth.uid == sessionId;
      allow create, update: if isAuth()
        && isAnonymousSession()
        && request.auth.uid == sessionId
        && request.resource.data.keys().hasOnly(['appUserId', 'updatedAt'])
        && request.resource.data.appUserId is string
        && request.resource.data.appUserId.size() > 0
        && request.resource.data.appUserId.size() <= 128;
    }

    // ── Shops ───────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if resource.data.isSuspended != true || isModerator();
      allow create: if isMerchant()
        // ✅ Fix #135: إضافة حقل id صريح مطابق لـ document id
        && request.resource.data.ownerId == appUid()
        && request.resource.data.id == shopId;
      allow update: if isShopOwner(shopId)
        // ✅ Fix #135: منع تغيير ownerId أو isSuspended من قِبَل التاجر
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'isSuspended', 'isFeatured'])
        || isModerator();
      allow delete: if isAdmin();

      // ✅ Fix #20: shops/{shopId}/daily_stats — إحصائيات يومية. قواعد الوثيقة الأم
      // لا تنسحب على الـ subcollections، وكانت من غير match فكل كتابة/قراءة
      // permission-denied. أي جلسة (زائر مسجّل) تزيد عدّاداً واحداً بمقدار 1
      // (شوف statCreated/statBumped)؛ القراءة لصاحب المحل والمشرف فقط (لوحة
      // التاجر)؛ الحذف للمشرف (تنظيف الـ Seeder والإدارة).
      match /daily_stats/{dateKey} {
        allow read: if isShopOwner(shopId) || isModerator();
        allow create: if isAuth()
          && (statCreated('views') || statCreated('phoneClicks')
            || statCreated('whatsappClicks') || statCreated('facebookClicks')
            || statCreated('instagramClicks') || statCreated('tiktokClicks')
            || statCreated('telegramClicks'));
        allow update: if isAuth()
          && (statBumped('views') || statBumped('phoneClicks')
            || statBumped('whatsappClicks') || statBumped('facebookClicks')
            || statBumped('instagramClicks') || statBumped('tiktokClicks')
            || statBumped('telegramClicks'));
        allow delete: if isModerator();
      }

      // ✅ Fix #20: shops/{shopId}/subscription_history — سجل التجديدات. يكتبه
      // SubscriptionService.renew() بعد نجاح الـ transaction (خارجه، "غير حرج")
      // بإسم صاحب المحل (renewedBy == هويّته) وتاريخ الخادم؛ بعد كده للقراءة فقط
      // (append-only زي admin_audit_log): صاحب المحل والمشرف يقروا، ولا تعديل
      // ولا حذف.
      match /subscription_history/{entryId} {
        allow read: if isShopOwner(shopId) || isModerator();
        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
              ['plan', 'price', 'startDate', 'endDate', 'renewedBy', 'activationCode', 'createdAt'])
          && request.resource.data.renewedBy == appUid()
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ── Products ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if resource.data.isVisible == true && resource.data.isShopHidden != true
        || isModerator()
        || (isAuth() && isShopOwner(resource.data.shopId));
      allow create: if isAuth() && isShopOwner(request.resource.data.shopId)
        && request.resource.data.id == productId;
      allow update: if isAuth() && isShopOwner(resource.data.shopId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId', 'isShopHidden'])
        || isModerator();
      allow delete: if isAuth() && isShopOwner(resource.data.shopId) || isModerator();
    }

    // ── Offers ───────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if resource.data.isActive == true && resource.data.isShopHidden != true
        || isModerator()
        || (isAuth() && isShopOwner(resource.data.shopId));
      allow create: if isAuth() && isShopOwner(request.resource.data.shopId)
        && request.resource.data.id == offerId;
      allow update: if isAuth() && isShopOwner(resource.data.shopId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId', 'isShopHidden'])
        || isModerator();
      allow delete: if isAuth() && isShopOwner(resource.data.shopId) || isModerator();
    }

    // ── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if resource.data.isVisible == true && resource.data.isShopHidden != true
        || isModerator()
        || (isAuth() && resource.data.ownerId == appUid());
      allow create: if isAuth()
        && request.resource.data.ownerId == appUid()
        && request.resource.data.id == serviceId;
      allow update: if isAuth() && resource.data.ownerId == appUid()
        || isModerator();
      allow delete: if isAuth() && resource.data.ownerId == appUid() || isModerator();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.userId == appUid()
        // ✅ Fix #135: منع نشر تقييم لعنصر لا يوجد
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isAuth() && resource.data.userId == appUid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'targetId'])
        || isModerator();
      allow delete: if isAuth() && resource.data.userId == appUid() || isModerator();
    }

    // ── Categories ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ── Activation Codes ─────────────────────────────────────────────────────
    match /activation_codes/{codeId} {
      allow read: if isModerator()
        || (isAuth() && resource.data.isUsed == false);
      allow create, delete: if isModerator();
      // ✅ Fix #16: كل أنواع الأكواد (shop_activation / shop_renewal /
      // ad_activation / dealer_listing_fee) في هذا الـ collection، والاستهلاك
      // يتم من حساب التاجر نفسه لا من المشرف: يحرق المستخدم كوداً غير مستخدم
      // لنفسه فقط (isUsed false→true، usedBy == هويته) ويلمس حقول الحرق وحدها.
      // أي تعديل آخر (تغيير الكود/نوعه/صلاحيته) للمشرف فقط.
      allow update: if isModerator()
        || (isAuth()
          && resource.data.isUsed == false
          && request.resource.data.isUsed == true
          && request.resource.data.usedBy == appUid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt', 'shopId']));
    }

    // ── Ads (إعلانات تجارية) ──────────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if resource.data.isActive == true || isModerator();
      allow create: if isAuth()
        && (isShopOwner(request.resource.data.shopId) || isModerator())
        && request.resource.data.id == adId;
      allow update, delete: if isAuth()
        && isShopOwner(resource.data.shopId) || isModerator();
    }

    // ── Job Ads ───────────────────────────────────────────────────────────────
    match /job_ads/{adId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.posterId == appUid()
        && request.resource.data.id == adId;
      allow update, delete: if isAuth() && resource.data.posterId == appUid()
        || isModerator();
    }

    // ── Service Requests ──────────────────────────────────────────────────────
    match /service_requests/{reqId} {
      allow read: if true;
      // ✅ Fix #15: صاحب الطلب هو clientId (الموديل/الشاشة/الـ Seeder يكتبون
      // clientId؛ القواعد كانت تفحص posterId غير الموجود فيُرفض كل إنشاء/تعديل)
      allow create: if isAuth()
        && request.resource.data.clientId == appUid()
        && request.resource.data.id == reqId;
      allow update: if (isAuth() && resource.data.clientId == appUid())
        || isModerator()
        // مقدّم عرض جديد يزيد العدّاد بمقدار 1 فقط (شاشة تقديم العرض تفعل ذلك)
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidsCount'])
          && request.resource.data.bidsCount == resource.data.bidsCount + 1);
      allow delete: if (isAuth() && resource.data.clientId == appUid())
        || isModerator();
    }

    // ── Service Bids (عروض الأسعار على طلبات الخدمة) ─────────────────────────
    // ✅ Fix #15: شكل واحد في الأربعة (الشاشات / الـ Seeder / القواعد / الموديل):
    // collection أعلى مستوى `service_bids` بحقلي requestId (الطلب) وproviderId
    // (مقدّم العرض) — كما تكتب وتقرأ الشاشات وكما يعرّفه ServiceBidModel.
    // كانت القواعد تحرس service_requests/{id}/bids بحقل bidderId (مسار وحقل لا
    // يكتب فيهما أحد) والـ Seeder يكتب تحت service_requests/{id}/service_bids.
    // صاحب الطلب = service_requests/{requestId}.clientId.
    match /service_bids/{bidId} {
      // يقرأ العرض: مقدّمه أو صاحب الطلب أو المشرف (العرض فيه هاتف المزوّد)
      allow read: if isAuth() && (
        resource.data.providerId == appUid()
        || serviceRequestData(resource.data.requestId).clientId == appUid()
        || isModerator()
      );
      // المزوّد يقدّم عرضاً معلّقاً بسعر موجب على طلب مفتوح ليس طلبه هو
      allow create: if isModerator()
        || (isAuth()
          && request.resource.data.keys().hasOnly(['id', 'requestId', 'providerId', 'providerName', 'providerPhone', 'offeredPrice', 'note', 'status', 'createdAt'])
          && request.resource.data.id == bidId
          && request.resource.data.providerId == appUid()
          && request.resource.data.status == 'pending'
          && request.resource.data.offeredPrice is number
          && request.resource.data.offeredPrice > 0
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId))
          && serviceRequestData(request.resource.data.requestId).status == 'open'
          && serviceRequestData(request.resource.data.requestId).clientId != appUid());
      // صاحب الطلب يقبل أو يرفض (حقل status فقط)
      allow update: if isAuth()
        && serviceRequestData(resource.data.requestId).clientId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      // المزوّد يسحب عرضه
      allow delete: if (isAuth() && resource.data.providerId == appUid()) || isModerator();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    // ✅ Fix #14: نظام الإشعارات = صندوقان بدور واضح لكل منهما (والصندوق الثالث
    // user_notifications أُلغي — كان الـ Seeder فقط يكتبه ولا أحد يقرأه):
    //   • notifications      → الصندوق الداخلي (يظهر في شاشة الإشعارات). كل مستند
    //                          موجَّه لمستخدم واحد عبر targetUserId — نفس الحقل
    //                          الذي تكتبه الشاشات وتفلتر به الواجهة (القواعد كانت
    //                          تفحص userId فلا تطابق أي مستند فعلي).
    //   • notification_queue → طابور FCM فقط (دفع خارجي عبر Cloud Function)،
    //                          التطبيق لا يقرؤه أبداً.
    // البث العام (all / merchants / customers) = Push فقط عبر notification_queue.
    match /notifications/{notifId} {
      allow read: if (isAuth() && resource.data.targetUserId == appUid()) || isModerator();
      // أي مستخدم مسجّل يقدر يُشعر مستخدماً آخر (مشتري ← تاجر، تاجر ← عميل،
      // دعوة قائمة...) بشرط: المرسل هو هو (fromUserId == appUid())، والشكل محدد،
      // وisRead=false وcreatedAt=request.time (لا تزوير ولا تواريخ مزيفة).
      allow create: if isModerator()
        || (isAuth()
          && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'data', 'isRead', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'isRead', 'createdAt'])
          && request.resource.data.fromUserId == appUid()
          && request.resource.data.targetUserId is string
          && request.resource.data.targetUserId.size() > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 1000
          && request.resource.data.type is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time);
      // المستلم يغيّر حالة القراءة/الدعوة فقط
      allow update: if isAuth()
        && resource.data.targetUserId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'inviteStatus']);
      allow delete: if (isAuth() && resource.data.targetUserId == appUid()) || isModerator();
    }

    // ── Notification Queue ────────────────────────────────────────────────────
    match /notification_queue/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if isModerator();
    }

    // ── Wishlists ─────────────────────────────────────────────────────────────
    match /wishlists/{listId} {
      allow read: if isAuth() && (
        resource.data.ownerId == appUid()
        || appUid() in resource.data.collaborators
        || resource.data.isPublic == true
      );
      allow create: if isAuth() && request.resource.data.ownerId == appUid();
      allow update: if isAuth() && (
        resource.data.ownerId == appUid()
        || appUid() in resource.data.collaborators
      );
      allow delete: if isAuth() && resource.data.ownerId == appUid();
    }

    // ── Complaints ────────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow read: if isAuth() && resource.data.userId == appUid() || isModerator();
      allow create: if isAuth() && request.resource.data.userId == appUid();
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // ── Dealer Listings (بيع المستعمل) ───────────────────────────────────────
    // ✅ Fix #19: كانت هذه القاعدة مكتوبة قبل appUid() (إصلاح #13) فلم يكن ممكناً
    // مطابقة sellerId بهوية الجلسة (الـ Mock يستخدم جلسة مجهولة عشوائية الـ uid)،
    // فاكتفت بـ isAuth() — ومعناه أن أي مستخدم موثّق، حتى جلسة مجهولة عارية،
    // يقدر يعدّل أو يحذف إعلان أي بائع. الآن الهوية متاحة عبر appUid() (الجلسة
    // الحقيقية: request.auth.uid، والـ Mock: من auth_sessions/{uid}) فالملكية
    // تُفرض هنا بدل الاعتماد على منطق التطبيق وحده:
    //   • إنشاء: sellerId == هويّتك (لا نشر باسم غيرك — وإلا صار «المالك» الوهمي
    //     هو من يملك التعديل والحذف) + عنوان غير فارغ.
    //   • تعديل: صاحب الإعلان فقط دون تغيير sellerId (لا نقل ملكية)، أو المشرف.
    //     (التطبيق يعدّل isActive فقط من تبويب "إعلاني" لصاحب الإعلان.)
    //   • حذف: صاحب الإعلان أو المشرف.
    // ✅ لا يُشترط id == listingId لأن التطبيق لا يكتب حقل id عند الإنشاء بـ .add().
    match /dealer_listings/{listingId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.sellerId == appUid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if (isAuth()
          && resource.data.sellerId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId']))
        || isModerator();
      allow delete: if (isAuth() && resource.data.sellerId == appUid())
        || isModerator();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ✅ Fix #17: settings مقروءة للعالم بالكامل (الزائر قبل أي تسجيل دخول)، وكان
    // مفتاح Gemini داخل settings/general فيقرؤه أي أحد بلا حساب أصلاً. الأسرار
    // الآن في settings_private/{docId} (مفتاح Gemini: settings_private/gemini
    // بحقل apiKey): تُقرأ من جلسة بهوية معروفة فقط (حقيقية أو Mock مربوطة)
    // ويكتبها المشرف. ⚠️ التطبيق يستدعي Gemini مباشرةً من الجهاز فالمفتاح يصل
    // لكل مستخدم مسجّل — الحماية الكاملة تحتاج وسيط Cloud Function + تقييد
    // المفتاح من Google Cloud Console (انظر ملاحظات changes-1.md).
    match /settings_private/{docId} {
      allow read: if hasSessionIdentity();
      allow write: if isModerator();
    }

    // ── Admin Audit Log ───────────────────────────────────────────────────────
    match /admin_audit_log/{logId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update, delete: if false; // سجل للقراءة فقط — لا حذف أبدًا
    }

    // ── Service Providers ────────────────────────────────────────────────────
    match /service_providers/{providerId} {
      allow read: if true;
      allow write: if isAuth() && appUid() == providerId || isModerator();
    }

    // ── Referrals ─────────────────────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuth() && (
        resource.data.referrerId == appUid()
        || resource.data.referredId == appUid()
      ) || isModerator();
      allow create: if isAuth() && request.resource.data.referredId == appUid();
      allow update: if isModerator();
      allow delete: if false;
    }

    // ── Share Analytics (نقرات روابط المشاركة) ─────────────────────────────────
    // ✅ Fix #20: DeepLinkService.recordShareClick يضيف حدثاً لكل نقرة
    // ({type, targetId, clickedAt, platform}). كانت الـ collection من غير match
    // فكل كتابة permission-denied (والدالة بتبلع الخطأ فالتحليلات بتضيع بصمت).
    // أي جلسة تسجّل حدثاً بالشكل ده بس؛ القراءة والتعديل والحذف للمشرف.
    match /share_analytics/{eventId} {
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['type', 'targetId', 'clickedAt', 'platform'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 32
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 32
        && request.resource.data.clickedAt == request.time;
      allow read, update, delete: if isModerator();
    }

    // ── Job Subscriptions (اشتراك إشعارات الوظائف) ─────────────────────────────
    // ✅ Fix #20: مستند لكل مستخدم (id = معرّفه في التطبيق): {categories[], updatedAt}
    // يكتبه job_ads_tab_screen عند تفعيل/إلغاء إشعارات فئة وظائف. صاحبه فقط.
    match /job_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // ── Provider Topic Subscriptions (اشتراك مزوّد الخدمة في مواضيع FCM) ─────────
    // ✅ Fix #20: مستند لكل مزوّد خدمة (id = معرّفه): {userId, categories[],
    // fcmTopics[], updatedAt} يكتبه تسجيل مزوّد الخدمة. صاحبه فقط.
    match /provider_topic_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'categories', 'fcmTopics', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.categories is list
        && request.resource.data.fcmTopics is list
        && request.resource.data.categories.size() <= 50
        && request.resource.data.fcmTopics.size() <= 50
        && request.resource.data.updatedAt == request.time;
    }

    // ── Collection Invites (دعوات القوائم المشتركة) ─────────────────────────────
    // ✅ Fix #20: collection_detail_screen يضيف دعوة (الداعي)، و notifications_screen
    // يقبلها/يرفضها (المدعو: تغيير status فقط). كانت من غير match فكل دعوة كانت
    // بتفشل من أول خطوة (permission-denied) وما يوصلش إشعار ولا FCM.
    //   • قراءة: المدعو أو الداعي أو المشرف.
    //   • إنشاء: inviterId == هويّتك، status == 'pending'، وتاريخ الخادم.
    //   • تعديل: المدعو فقط، status فقط إلى accepted/rejected.
    //   • حذف: أي طرف في الدعوة أو المشرف.
    match /collection_invites/{inviteId} {
      allow read: if (isAuth()
          && (resource.data.inviteeId == appUid() || resource.data.inviterId == appUid()))
        || isModerator();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(
            ['collectionId', 'collectionName', 'inviterId', 'inviterName', 'inviteeId', 'status', 'createdAt'])
        && request.resource.data.inviterId == appUid()
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAuth()
        && resource.data.inviteeId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if (isAuth()
          && (resource.data.inviterId == appUid() || resource.data.inviteeId == appUid()))
        || isModerator();
    }
  }
}
