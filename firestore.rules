rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }

    function isAnonymousSession() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ✅ Security Fix (P0): إلغاء الاعتماد على auth_sessions في الإنتاج لمنع انتحال هوية الأدمن أو التجار
    function appUid() {
      return request.auth.uid;
    }

    function isOwner(uid) { return isAuth() && appUid() == uid; }

    function hasSessionIdentity() {
      return isAuth() && !isAnonymousSession();
    }

    function userDocExists() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(appUid()));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(appUid())).data;
    }

    function isAdmin() {
      return userDocExists() && getUserData().userType in ['admin', 'super_admin'];
    }

    function isModerator() {
      return userDocExists() && getUserData().userType in ['admin', 'super_admin', 'moderator'];
    }

    function isMerchant() {
      return userDocExists() && getUserData().userType == 'merchant';
    }

    function isShopOwner(shopId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == appUid();
    }

    // ✅ دعم أعضاء فريق المتجر (partner / worker) المرتبطين عبر linkedShopId
    function isShopTeamMember(shopId) {
      return userDocExists() &&
        getUserData().get('linkedShopId', '') == shopId &&
        getUserData().get('shopRole', '') in ['owner', 'partner', 'worker'];
    }

    function canManageShopContent(shopId) {
      return isShopOwner(shopId) || isShopTeamMember(shopId) || isModerator();
    }

    function canReplyToReview(revData) {
      return ('shopId' in revData && revData.shopId is string && revData.shopId.size() > 0 && canManageShopContent(revData.shopId))
        || canManageShopContent(revData.targetId)
        || (revData.get('targetType', '') == 'product'
            && exists(/databases/$(database)/documents/products/$(revData.targetId))
            && canManageShopContent(get(/databases/$(database)/documents/products/$(revData.targetId)).data.shopId));
    }

    function serviceRequestData(requestId) {
      return get(/databases/$(database)/documents/service_requests/$(requestId)).data;
    }

    function notDeleted() { return resource.data.isDeleted != true; }
    function notSuspended() { return resource.data.isSuspended != true; }

    function statCreated(f) {
      return request.resource.data.keys().hasOnly([f, 'date'])
        && f in request.resource.data
        && request.resource.data[f] == 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }

    function statBumped(f) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly([f])
          || (changed.hasOnly([f, 'date']) && !('date' in resource.data)))
        && request.resource.data[f] == (f in resource.data ? resource.data[f] : 0) + 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }

    // ✅ Security Fix (P0): دوال التحقق الصارم من العدادات لمنع التلاعب بالمشاهدات والتقييمات والمفضلة
    function isCounterIncrementedByOne(field) {
      let prev = (field in resource.data && resource.data[field] is number) ? resource.data[field] : 0;
      return request.resource.data[field] is number && request.resource.data[field] == prev + 1;
    }

    function isFavoriteDeltaOne() {
      let prev = ('favoriteCount' in resource.data && resource.data.favoriteCount is number) ? resource.data.favoriteCount : 0;
      let next = request.resource.data.favoriteCount;
      return next is number && next >= 0 && (next == prev + 1 || next == prev - 1);
    }

    function isValidRatingUpdate() {
      let prevCount = ('reviewCount' in resource.data && resource.data.reviewCount is number) ? resource.data.reviewCount : 0;
      let nextCount = request.resource.data.reviewCount;
      let nextRating = request.resource.data.rating;
      return nextRating is number && nextRating >= 0 && nextRating <= 5
        && nextCount is number && nextCount >= 0
        && (nextCount == prevCount + 1 || nextCount == prevCount || nextCount == prevCount - 1);
    }

    function isValidShopMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['phoneClicks']) && isCounterIncrementedByOne('phoneClicks'))
        || (changed.hasOnly(['whatsappClicks']) && isCounterIncrementedByOne('whatsappClicks'))
        || (changed.hasOnly(['facebookClicks']) && isCounterIncrementedByOne('facebookClicks'))
        || (changed.hasOnly(['instagramClicks']) && isCounterIncrementedByOne('instagramClicks'))
        || (changed.hasOnly(['tiktokClicks']) && isCounterIncrementedByOne('tiktokClicks'))
        || (changed.hasOnly(['telegramClicks']) && isCounterIncrementedByOne('telegramClicks'))
        || (changed.hasOnly(['uniqueVisitors']) && isCounterIncrementedByOne('uniqueVisitors'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne())
        || (changed.hasOnly(['rating', 'reviewCount']) && isValidRatingUpdate());
    }

    function isValidProductMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne())
        || (changed.hasOnly(['rating', 'reviewCount']) && isValidRatingUpdate());
    }

    function isValidOfferMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne());
    }

    // ── Usernames (حجز أسماء المستخدمين الفريدة) ────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == appUid();
      allow update: if isAuth() && resource.data.uid == appUid() && request.resource.data.uid == appUid();
      allow delete: if (isAuth() && resource.data.uid == appUid()) || isModerator();
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAuth();
      allow list: if isModerator() || (isAuth() && request.query.limit <= 25);
      allow create: if (isOwner(userId)
        && (!request.resource.data.keys().hasAny(['userType'])
          || request.resource.data.userType in ['customer', 'merchant']))
        || isAdmin();

      function teamFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['linkedShopId', 'shopRole', 'userType']);
      }
      function isTeamAdd() {
        return teamFieldsOnly()
          && !isOwner(userId)
          && isMerchant()
          && resource.data.userType == 'customer'
          && request.resource.data.userType == 'merchant'
          && request.resource.data.shopRole in ['partner', 'worker']
          && request.resource.data.linkedShopId is string
          && isShopOwner(request.resource.data.linkedShopId);
      }
      function isTeamRemove() {
        return teamFieldsOnly()
          && !isOwner(userId)
          && isMerchant()
          && resource.data.userType == 'merchant'
          && resource.data.shopRole in ['partner', 'worker']
          && resource.data.linkedShopId is string
          && isShopOwner(resource.data.linkedShopId)
          && request.resource.data.userType == 'customer'
          && request.resource.data.linkedShopId == null
          && request.resource.data.shopRole == 'owner';
      }
      function isReferralRewardBump() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let prevCount = ('referralCount' in resource.data && resource.data.referralCount is number) ? resource.data.referralCount : 0;
        let prevDays = ('referralBonusDaysEarned' in resource.data && resource.data.referralBonusDaysEarned is number) ? resource.data.referralBonusDaysEarned : 0;
        return isAuth()
          && !isOwner(userId)
          && changed.hasOnly(['referralCount', 'referralBonusDaysEarned'])
          && request.resource.data.referralCount == prevCount + 1
          && request.resource.data.referralBonusDaysEarned == prevDays + 7;
      }

      allow update: if (isOwner(userId)
          && !(request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isSuspended',
            'linkedShopId'
          ]))
          && (!('userType' in request.resource.data)
            || request.resource.data.userType == resource.data.userType
            || request.resource.data.userType in ['customer', 'merchant']))
        || isAdmin()
        || isTeamAdd()
        || isTeamRemove()
        || isReferralRewardBump();
      allow delete: if isOwner(userId) || isAdmin();

      // Favorites sub-collection
      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Auth Sessions (مغلقة في الإنتاج لمنع انتحال الهوية) ─────────────────
    match /auth_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Shops ───────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if resource.data.isSuspended != true || isModerator() || canManageShopContent(shopId);
      allow create: if (isMerchant()
          && request.resource.data.ownerId == appUid()
          && request.resource.data.id == shopId)
        || isAdmin();
      allow update: if (isShopOwner(shopId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'isSuspended', 'isFeatured']))
        || isModerator()
        || (isAuth()
          && resource.data.pendingOwnerPhone is string
          && resource.data.pendingOwnerPhone.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'pendingOwnerPhone', 'updatedAt'])
          && request.resource.data.ownerId == appUid()
          && request.resource.data.pendingOwnerPhone == null)
        || (isAuth() && isValidShopMetricUpdate());
      allow delete: if isAdmin();

      match /daily_stats/{dateKey} {
        allow read: if canManageShopContent(shopId);
        allow create: if isAuth()
          && (statCreated('views') || statCreated('phoneClicks')
            || statCreated('whatsappClicks') || statCreated('facebookClicks')
            || statCreated('instagramClicks') || statCreated('tiktokClicks')
            || statCreated('telegramClicks'));
        allow update: if isAuth()
          && (statBumped('views') || statBumped('phoneClicks')
            || statBumped('whatsappClicks') || statBumped('facebookClicks')
            || statBumped('instagramClicks') || statBumped('tiktokClicks')
            || statBumped('telegramClicks'));
        allow delete: if isModerator();
      }

      match /subscription_history/{entryId} {
        allow read: if canManageShopContent(shopId);
        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
              ['plan', 'price', 'startDate', 'endDate', 'renewedBy', 'activationCode', 'createdAt'])
          && request.resource.data.renewedBy == appUid()
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ── Products ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if (resource.data.isVisible == true && resource.data.isShopHidden != true)
        || isModerator()
        || canManageShopContent(resource.data.shopId);
      allow create: if (canManageShopContent(request.resource.data.shopId)
        && request.resource.data.id == productId)
        || isAdmin();
      allow update: if (canManageShopContent(resource.data.shopId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId', 'isShopHidden']))
        || isModerator()
        || (isAuth() && isValidProductMetricUpdate())
        || (isAuth()
          && isShopOwner(resource.data.shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShopHidden', 'isVisible']));
      allow delete: if canManageShopContent(resource.data.shopId);
    }

    // ── Offers ───────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if (resource.data.isActive == true && resource.data.isShopHidden != true)
        || isModerator()
        || canManageShopContent(resource.data.shopId);
      allow create: if (canManageShopContent(request.resource.data.shopId)
        && request.resource.data.id == offerId)
        || isAdmin();
      allow update: if (canManageShopContent(resource.data.shopId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId', 'isShopHidden']))
        || isModerator()
        || (isAuth() && isValidOfferMetricUpdate())
        || (isAuth()
          && isShopOwner(resource.data.shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShopHidden', 'isActive', 'isVisible']));
      allow delete: if canManageShopContent(resource.data.shopId);
    }

    // ── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if (resource.data.isVisible == true && resource.data.isShopHidden != true)
        || isModerator()
        || (isAuth() && resource.data.ownerId == appUid())
        || ('shopId' in resource.data && canManageShopContent(resource.data.shopId));
      allow create: if isAuth()
        && (request.resource.data.ownerId == appUid()
          || ('shopId' in request.resource.data && canManageShopContent(request.resource.data.shopId)))
        && request.resource.data.id == serviceId;
      allow update: if (isAuth() && resource.data.ownerId == appUid())
        || ('shopId' in resource.data && canManageShopContent(resource.data.shopId))
        || isModerator();
      allow delete: if (isAuth() && resource.data.ownerId == appUid())
        || ('shopId' in resource.data && canManageShopContent(resource.data.shopId))
        || isModerator();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (isAuth()
        && request.resource.data.userId == appUid()
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5)
        || isAdmin();
      // ✅ Security Fix (P0): قصر الرد على التقييمات بصاحب/فريق المحل الفعلي أو المشرف فقط
      allow update: if (isAuth() && resource.data.userId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'targetId']))
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt', 'hasReply'])
          && canReplyToReview(resource.data))
        || isModerator();
      allow delete: if (isAuth() && resource.data.userId == appUid()) || isModerator();
    }

    // ── Categories ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ── Activation Codes ─────────────────────────────────────────────────────
    match /activation_codes/{codeId} {
      allow get: if isModerator()
        || (isAuth() && resource.data.isUsed == false);
      allow list: if isModerator();
      allow create, delete: if isModerator();
      allow update: if isModerator()
        || (isAuth()
          && resource.data.isUsed == false
          && request.resource.data.isUsed == true
          && request.resource.data.usedBy == appUid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt', 'shopId']));
    }

    // ── Ads (إعلانات تجارية) ─────────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if resource.data.isActive == true
        || isModerator()
        || ('shopId' in resource.data && resource.data.shopId is string && canManageShopContent(resource.data.shopId));
      allow create: if isAuth()
        && (isModerator()
          || ('shopId' in request.resource.data && request.resource.data.shopId is string && canManageShopContent(request.resource.data.shopId)))
        && request.resource.data.id == adId;
      // ✅ Security Fix (P0): اشتراط زيادة clickCount بمقدار +1 فقط للزوار
      allow update: if isModerator()
        || ('shopId' in resource.data && resource.data.shopId is string && canManageShopContent(resource.data.shopId))
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
          && isCounterIncrementedByOne('clickCount'));
      allow delete: if isModerator()
        || ('shopId' in resource.data && resource.data.shopId is string && canManageShopContent(resource.data.shopId));
    }

    // ── Subscription Requests ────────────────────────────────────────────────
    match /subscription_requests/{reqId} {
      allow read: if isModerator() || (isAuth() && resource.data.userId == appUid());
      allow create: if (isAuth() && request.resource.data.userId == appUid()) || isAdmin();
      allow update, delete: if isModerator();
    }

    // ── Job Ads ───────────────────────────────────────────────────────────────
    match /job_ads/{adId} {
      allow read: if true;
      allow create: if (isAuth()
        && request.resource.data.posterId == appUid()
        && request.resource.data.id == adId)
        || isAdmin();
      allow update, delete: if (isAuth() && resource.data.posterId == appUid())
        || isModerator();
    }

    // ── Service Requests ──────────────────────────────────────────────────────
    match /service_requests/{reqId} {
      allow read: if isAuth();
      allow create: if (isAuth()
        && request.resource.data.clientId == appUid()
        && request.resource.data.id == reqId)
        || isAdmin();
      allow update: if (isAuth() && resource.data.clientId == appUid())
        || isModerator()
        || (isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidsCount'])
          && request.resource.data.bidsCount == resource.data.bidsCount + 1);
      allow delete: if (isAuth() && resource.data.clientId == appUid())
        || isModerator();
    }

    // ── Service Bids (عروض الأسعار على طلبات الخدمة) ─────────────────────────
    match /service_bids/{bidId} {
      allow read: if isAuth() && (
        resource.data.providerId == appUid()
        || serviceRequestData(resource.data.requestId).clientId == appUid()
        || isModerator()
      );
      allow create: if isModerator()
        || (isAuth()
          && request.resource.data.keys().hasOnly(['id', 'requestId', 'providerId', 'providerName', 'providerPhone', 'offeredPrice', 'note', 'status', 'createdAt'])
          && request.resource.data.id == bidId
          && request.resource.data.providerId == appUid()
          && request.resource.data.status == 'pending'
          && request.resource.data.offeredPrice is number
          && request.resource.data.offeredPrice > 0
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId))
          && serviceRequestData(request.resource.data.requestId).status == 'open'
          && serviceRequestData(request.resource.data.requestId).clientId != appUid());
      allow update: if isAuth()
        && serviceRequestData(resource.data.requestId).clientId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if (isAuth() && resource.data.providerId == appUid()) || isModerator();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if (isAuth() && resource.data.targetUserId == appUid()) || isModerator();
      allow create: if isModerator()
        || (isAuth()
          && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'data', 'isRead', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'isRead', 'createdAt'])
          && request.resource.data.fromUserId == appUid()
          && request.resource.data.targetUserId is string
          && request.resource.data.targetUserId.size() > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 1000
          && request.resource.data.type is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time);
      allow update: if isAuth()
        && resource.data.targetUserId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'inviteStatus']);
      allow delete: if (isAuth() && resource.data.targetUserId == appUid()) || isModerator();
    }

    // ── Notification Queue ────────────────────────────────────────────────────
    match /notification_queue/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if isModerator();
    }

    // ── Wishlists ─────────────────────────────────────────────────────────────
    match /wishlists/{listId} {
      allow read: if isAuth() && (
        resource.data.ownerId == appUid()
        || appUid() in resource.data.collaborators
        || resource.data.isPublic == true
      );
      allow create: if (isAuth() && request.resource.data.ownerId == appUid()) || isAdmin();
      allow update: if isAuth() && (
        resource.data.ownerId == appUid()
        || appUid() in resource.data.collaborators
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators'])
          && request.resource.data.collaborators is list
          && request.resource.data.collaborators.hasAll(resource.data.collaborators)
          && request.resource.data.collaborators.size() == resource.data.collaborators.size() + 1
          && appUid() in request.resource.data.collaborators
        )
      );
      allow delete: if isAuth() && resource.data.ownerId == appUid();
    }

    // ── Complaints ────────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow read: if (isAuth() && resource.data.userId == appUid()) || isModerator();
      allow create: if (isAuth() && request.resource.data.userId == appUid()) || isAdmin();
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // ── Dealer Listings (بيع المستعمل) ───────────────────────────────────────
    match /dealer_listings/{listingId} {
      allow read: if true;
      allow create: if (isAuth()
        && request.resource.data.sellerId == appUid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0)
        || isAdmin();
      allow update: if (isAuth()
          && resource.data.sellerId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId']))
        || isModerator();
      allow delete: if (isAuth() && resource.data.sellerId == appUid())
        || isModerator();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ✅ Security Fix (P0): قفل قراءة وكتابة settings_private على المشرفين فقط لحماية مفتاح Gemini
    match /settings_private/{docId} {
      allow read, write: if isModerator();
    }

    // ── Admin Audit Log ───────────────────────────────────────────────────────
    match /admin_audit_log/{logId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update, delete: if false;
    }

    // ── Service Providers ────────────────────────────────────────────────────
    match /service_providers/{providerId} {
      allow read: if true;
      allow write: if (isAuth() && appUid() == providerId) || isModerator();
    }

    // ── Referrals ─────────────────────────────────────────────────────────────
    // ✅ دعم referredId و newUserId للتوافق الكامل مع ReferralService
    match /referrals/{referralId} {
      allow read: if (isAuth() && (
        resource.data.referrerId == appUid()
        || resource.data.get('referredId', '') == appUid()
        || resource.data.get('newUserId', '') == appUid()
      )) || isModerator();
      allow create: if isAuth() && (
        request.resource.data.get('referredId', '') == appUid()
        || request.resource.data.get('newUserId', '') == appUid()
      );
      allow update: if isModerator();
      allow delete: if false;
    }

    // ── Share Analytics (نقرات روابط المشاركة) ─────────────────────────────────
    match /share_analytics/{eventId} {
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['type', 'targetId', 'clickedAt', 'platform'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 32
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 32
        && request.resource.data.clickedAt == request.time;
      allow read, update, delete: if isModerator();
    }

    // ── Job Subscriptions (اشتراك إشعارات الوظائف) ─────────────────────────────
    match /job_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // ── Provider Topic Subscriptions (اشتراك مزوّد الخدمة في مواضيع FCM) ─────────
    match /provider_topic_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'categories', 'fcmTopics', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.categories is list
        && request.resource.data.fcmTopics is list
        && request.resource.data.categories.size() <= 50
        && request.resource.data.fcmTopics.size() <= 50
        && request.resource.data.updatedAt == request.time;
    }

    // ── Collection Invites (دعوات القوائم المشتركة) ─────────────────────────────
    match /collection_invites/{inviteId} {
      allow read: if (isAuth()
          && (resource.data.inviteeId == appUid() || resource.data.inviterId == appUid()))
        || isModerator();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(
            ['collectionId', 'collectionName', 'inviterId', 'inviterName', 'inviteeId', 'status', 'createdAt'])
        && request.resource.data.inviterId == appUid()
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAuth()
        && resource.data.inviteeId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if (isAuth()
          && (resource.data.inviterId == appUid() || resource.data.inviteeId == appUid()))
        || isModerator();
    }
  }
}
