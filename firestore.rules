rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }

    function isAnonymousSession() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ✅ P1-1 Fix: منع الجلسات المجهولة من كافة الصلاحيات المحمية
    function hasSessionIdentity() {
      return isAuth() && !isAnonymousSession();
    }

    function appUid() {
      return request.auth.uid;
    }

    function isOwner(uid) {
      return hasSessionIdentity() && appUid() == uid;
    }

    function tokenRole() {
      return ('userType' in request.auth.token && request.auth.token.userType is string)
        ? request.auth.token.userType
        : (('role' in request.auth.token && request.auth.token.role is string)
            ? request.auth.token.role
            : '');
    }

    function userDocExists() {
      return hasSessionIdentity() && exists(/databases/$(database)/documents/users/$(appUid()));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(appUid())).data;
    }

    function effectiveUserType() {
      return tokenRole() != ''
        ? tokenRole()
        : (userDocExists() ? getUserData().get('userType', 'customer') : '');
    }

    function isSuperAdmin() {
      return hasSessionIdentity() && effectiveUserType() == 'super_admin';
    }

    function isAdmin() {
      return hasSessionIdentity() && effectiveUserType() in ['admin', 'super_admin'];
    }

    function isModerator() {
      return hasSessionIdentity() && effectiveUserType() in ['admin', 'super_admin', 'moderator'];
    }

    // ✅ P1-5 Fix: احترام مصفوفة صلاحيات المشرف (moderatorPermissions) في القواعد الخلفية
    function hasModPerm(permKey) {
      return isAdmin()
        || (hasSessionIdentity()
            && effectiveUserType() == 'moderator'
            && userDocExists()
            && 'moderatorPermissions' in getUserData()
            && getUserData().moderatorPermissions is map
            && getUserData().moderatorPermissions.get(permKey, false) == true);
    }

    function isMerchant() {
      return hasSessionIdentity() && effectiveUserType() == 'merchant';
    }

    function isServiceProvider() {
      return hasSessionIdentity() && (
        exists(/databases/$(database)/documents/service_providers/$(appUid()))
        || (userDocExists() && getUserData().get('businessType', '') == 'service_provider')
      );
    }

    function isShopOwner(shopId) {
      return hasSessionIdentity() &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == appUid();
    }

    function isShopTeamMember(shopId) {
      return userDocExists() &&
        getUserData().get('linkedShopId', '') == shopId &&
        getUserData().get('shopRole', '') in ['owner', 'partner', 'worker'];
    }

    function isShopPartner(shopId) {
      return userDocExists() &&
        getUserData().get('linkedShopId', '') == shopId &&
        getUserData().get('shopRole', '') in ['owner', 'partner'];
    }

    function canManageShopContent(shopId) {
      return isShopOwner(shopId) || isShopTeamMember(shopId) || hasModPerm('manageShops');
    }

    function canReplyToReview(revData) {
      return ('shopId' in revData && revData.shopId is string && revData.shopId.size() > 0 && canManageShopContent(revData.shopId))
        || canManageShopContent(revData.targetId)
        || (revData.get('targetType', '') == 'product'
            && exists(/databases/$(database)/documents/products/$(revData.targetId))
            && canManageShopContent(get(/databases/$(database)/documents/products/$(revData.targetId)).data.shopId));
    }

    function serviceRequestData(requestId) {
      return get(/databases/$(database)/documents/service_requests/$(requestId)).data;
    }

    function statCreated(f) {
      return request.resource.data.keys().hasOnly([f, 'date'])
        && f in request.resource.data
        && request.resource.data[f] == 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }

    function statBumped(f) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly([f])
          || (changed.hasOnly([f, 'date']) && !('date' in resource.data)))
        && request.resource.data[f] == (f in resource.data ? resource.data[f] : 0) + 1
        && (!('date' in request.resource.data) || request.resource.data.date is timestamp);
    }

    // ✅ دوال التحقق الصارم من العدادات (تم إلغاء تعديل rating و reviewCount من العميل نهائياً)
    function isCounterIncrementedByOne(field) {
      let prev = (field in resource.data && resource.data[field] is number) ? resource.data[field] : 0;
      return request.resource.data[field] is number && request.resource.data[field] == prev + 1;
    }

    function isFavoriteDeltaOne() {
      let prev = ('favoriteCount' in resource.data && resource.data.favoriteCount is number) ? resource.data.favoriteCount : 0;
      let next = request.resource.data.favoriteCount;
      return next is number && next >= 0 && (next == prev + 1 || next == prev - 1);
    }

    function isValidShopMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['phoneClicks']) && isCounterIncrementedByOne('phoneClicks'))
        || (changed.hasOnly(['whatsappClicks']) && isCounterIncrementedByOne('whatsappClicks'))
        || (changed.hasOnly(['facebookClicks']) && isCounterIncrementedByOne('facebookClicks'))
        || (changed.hasOnly(['instagramClicks']) && isCounterIncrementedByOne('instagramClicks'))
        || (changed.hasOnly(['tiktokClicks']) && isCounterIncrementedByOne('tiktokClicks'))
        || (changed.hasOnly(['telegramClicks']) && isCounterIncrementedByOne('telegramClicks'))
        || (changed.hasOnly(['uniqueVisitors']) && isCounterIncrementedByOne('uniqueVisitors'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne());
    }

    function isValidProductMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne());
    }

    function isValidOfferMetricUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (changed.hasOnly(['views']) && isCounterIncrementedByOne('views'))
        || (changed.hasOnly(['favoriteCount']) && isFavoriteDeltaOne());
    }

    // ── Usernames (حجز أسماء المستخدمين الفريدة) ────────────────────────────
    match /usernames/{username} {
      allow get: if true;
      allow list: if hasModPerm('manageUsers');
      allow create: if hasSessionIdentity()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == appUid();
      allow update: if hasSessionIdentity()
        && resource.data.uid == appUid()
        && request.resource.data.uid == appUid();
      allow delete: if (hasSessionIdentity() && resource.data.uid == appUid()) || hasModPerm('manageUsers');
    }

    // ── Users (P0-1, P0-5, P0-6 Fixed) ──────────────────────────────────────
    match /users/{userId} {
      // ✅ P0-5 Fix: قصر قراءة الوثيقة على صاحبها أو المشرف المختص ومنع استخراج قائمة الهواتف
      allow get: if isOwner(userId) || hasModPerm('manageUsers');
      allow list: if hasModPerm('manageUsers');

      // ✅ P0-1 Fix: التسجيل الذاتي يبدأ دائماً كـ customer فقط وبقيم إحالة صفرية؛ الترقية لـ merchant تتم عبر Cloud Function
      allow create: if (isOwner(userId)
        && request.resource.data.get('userType', 'customer') == 'customer'
        && request.resource.data.get('isSuspended', false) == false
        && request.resource.data.get('referralCount', 0) == 0
        && request.resource.data.get('referralBonusDaysEarned', 0) == 0
        && !request.resource.data.keys().hasAny(['linkedShopId', 'moderatorPermissions', 'featuredUntil', 'referredBy']))
        || isAdmin();

      // ✅ P0-1 & P0-6 Fix: منع المستخدم من تعديل userType أو shopRole أو linkedShopId أو أرقام الإحالة أو الصلاحيات
      allow update: if (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'userType',
            'shopRole',
            'isSuspended',
            'linkedShopId',
            'referralCount',
            'referralBonusDaysEarned',
            'referredBy',
            'referredByCode',
            'referredAt',
            'referralAppliedAt',
            'featuredUntil',
            'moderatorPermissions',
            'email',
            'phone'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode'])
              || resource.data.get('referralCode', '') == ''))
        || (hasModPerm('manageUsers')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType', 'moderatorPermissions'])
                || isAdmin()));

      allow delete: if isOwner(userId) || isAdmin();

      match /favorites/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Auth Sessions (مغلقة بالكامل) ────────────────────────────────────────
    match /auth_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Shops (P0-1, P0-2, P0-3, P0-9 Fixed) ────────────────────────────────
    match /shops/{shopId} {
      allow read: if resource.data.isSuspended != true || hasModPerm('manageShops') || canManageShopContent(shopId);

      // ✅ P0-1 Fix: إنشاء المحلات يتم حصرياً عبر Cloud Function (createShopWithCode) أو من الأدمن
      allow create: if hasModPerm('manageShops');

      // ✅ P0-2 & P0-3 & P0-9 Fix: منع المالك من تعديل حقول الاشتراك أو التميز أو التقييم، وإلغاء المطالبة المباشرة بـ pendingOwnerPhone
      allow update: if ((isShopOwner(shopId) || isShopPartner(shopId))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id',
            'ownerId',
            'pendingOwnerPhone',
            'isSuspended',
            'isFeatured',
            'subscriptionPlan',
            'subscriptionStartDate',
            'subscriptionEndDate',
            'subscriptionStatus',
            'lastRenewalAt',
            'renewedBy',
            'lastActivationCode',
            'rating',
            'reviewCount',
            'views',
            'uniqueVisitors',
            'favoriteCount',
            'phoneClicks',
            'whatsappClicks',
            'facebookClicks',
            'instagramClicks',
            'tiktokClicks',
            'telegramClicks'
          ]))
        || hasModPerm('manageShops')
        || (hasSessionIdentity() && isValidShopMetricUpdate());

      allow delete: if isAdmin();

      match /daily_stats/{dateKey} {
        allow read: if canManageShopContent(shopId);
        allow create: if hasSessionIdentity()
          && (statCreated('views') || statCreated('phoneClicks')
            || statCreated('whatsappClicks') || statCreated('facebookClicks')
            || statCreated('instagramClicks') || statCreated('tiktokClicks')
            || statCreated('telegramClicks'));
        allow update: if hasSessionIdentity()
          && (statBumped('views') || statBumped('phoneClicks')
            || statBumped('whatsappClicks') || statBumped('facebookClicks')
            || statBumped('instagramClicks') || statBumped('tiktokClicks')
            || statBumped('telegramClicks'));
        allow delete: if hasModPerm('manageShops');
      }

      match /subscription_history/{entryId} {
        allow read: if canManageShopContent(shopId);
        allow create, update, delete: if false;
      }
    }

    // ── Products ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if (resource.data.isVisible == true && resource.data.isShopHidden != true)
        || hasModPerm('manageProducts')
        || canManageShopContent(resource.data.shopId);
      allow create: if (canManageShopContent(request.resource.data.shopId)
        && request.resource.data.id == productId
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0)
        || hasModPerm('manageProducts');
      allow update: if (canManageShopContent(resource.data.shopId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id', 'shopId', 'isShopHidden', 'rating', 'reviewCount', 'views', 'favoriteCount'
          ]))
        || hasModPerm('manageProducts')
        || (hasSessionIdentity() && isValidProductMetricUpdate())
        || (hasSessionIdentity()
          && isShopOwner(resource.data.shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShopHidden', 'isVisible']));
      allow delete: if canManageShopContent(resource.data.shopId) || hasModPerm('manageProducts');
    }

    // ── Offers ───────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if (resource.data.isActive == true && resource.data.isShopHidden != true)
        || hasModPerm('manageOffers')
        || canManageShopContent(resource.data.shopId);
      allow create: if (canManageShopContent(request.resource.data.shopId)
        && request.resource.data.id == offerId)
        || hasModPerm('manageOffers');
      allow update: if (canManageShopContent(resource.data.shopId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id', 'shopId', 'isShopHidden', 'views', 'favoriteCount'
          ]))
        || hasModPerm('manageOffers')
        || (hasSessionIdentity() && isValidOfferMetricUpdate())
        || (hasSessionIdentity()
          && isShopOwner(resource.data.shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isShopHidden', 'isActive', 'isVisible']));
      allow delete: if canManageShopContent(resource.data.shopId) || hasModPerm('manageOffers');
    }

    // ── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if (resource.data.isVisible == true && resource.data.isShopHidden != true)
        || hasModPerm('manageShops')
        || (hasSessionIdentity() && resource.data.ownerId == appUid())
        || ('shopId' in resource.data && canManageShopContent(resource.data.shopId));
      allow create: if hasSessionIdentity()
        && (request.resource.data.ownerId == appUid()
          || ('shopId' in request.resource.data && canManageShopContent(request.resource.data.shopId)))
        && request.resource.data.id == serviceId
        && !request.resource.data.keys().hasAny(['isFeatured', 'isSuspended']);
      allow update: if ((hasSessionIdentity() && resource.data.ownerId == appUid())
          || ('shopId' in resource.data && canManageShopContent(resource.data.shopId)))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'ownerId', 'shopId', 'isShopHidden'])
        || hasModPerm('manageShops');
      allow delete: if (hasSessionIdentity() && resource.data.ownerId == appUid())
        || ('shopId' in resource.data && canManageShopContent(resource.data.shopId))
        || hasModPerm('manageShops');
    }

    // ── Reviews (P0-9 & P1-8 Fixed: منع تكرار التقييم عبر معرف حتمي userId_targetId) ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (hasSessionIdentity()
        && reviewId == appUid() + '_' + request.resource.data.targetId
        && request.resource.data.userId == appUid()
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 2000)))
        || isAdmin();
      allow update: if (hasSessionIdentity() && resource.data.userId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'userId', 'targetId', 'targetType', 'shopId', 'reply', 'repliedAt', 'hasReply'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5)
        || (hasSessionIdentity()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt', 'hasReply'])
          && canReplyToReview(resource.data))
        || hasModPerm('manageShops');
      allow delete: if (hasSessionIdentity() && resource.data.userId == appUid()) || hasModPerm('manageShops');
    }

    // ── Categories ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if hasModPerm('manageCategories');
    }

    // ── Activation Codes (P0-1, P0-2, P1-7 Fixed: مقصورة على الإدارة وCloud Functions) ──
    match /activation_codes/{codeId} {
      allow get, list, create, update, delete: if hasModPerm('manageActivationCodes');
    }

    // ── Ads (إعلانات تجارية) ─────────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if resource.data.isActive == true
        || hasModPerm('manageAds')
        || ('shopId' in resource.data && resource.data.shopId is string && canManageShopContent(resource.data.shopId));
      allow create: if hasSessionIdentity()
        && (hasModPerm('manageAds')
          || ('shopId' in request.resource.data
              && request.resource.data.shopId is string
              && canManageShopContent(request.resource.data.shopId)
              && request.resource.data.get('isActive', false) == false))
        && request.resource.data.id == adId;
      allow update: if hasModPerm('manageAds')
        || ('shopId' in resource.data && resource.data.shopId is string
            && canManageShopContent(resource.data.shopId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive', 'isMainActive', 'status', 'isPaid', 'clickCount']))
        || (hasSessionIdentity()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
          && isCounterIncrementedByOne('clickCount'));
      allow delete: if hasModPerm('manageAds')
        || ('shopId' in resource.data && resource.data.shopId is string && canManageShopContent(resource.data.shopId));
    }

    // ── Subscription Requests ────────────────────────────────────────────────
    match /subscription_requests/{reqId} {
      allow read: if hasModPerm('manageActivationCodes') || (hasSessionIdentity() && resource.data.userId == appUid());
      allow create: if (hasSessionIdentity() && request.resource.data.userId == appUid()) || isAdmin();
      allow update, delete: if hasModPerm('manageActivationCodes');
    }

    // ── Job Ads (P1-8 Fixed: تقييد الحقول والأحجام) ──────────────────────────
    match /job_ads/{adId} {
      allow read: if true;
      allow create: if (hasSessionIdentity()
        && request.resource.data.posterId == appUid()
        && request.resource.data.id == adId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200)
        || isAdmin();
      allow update: if (hasSessionIdentity()
          && resource.data.posterId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'posterId', 'createdAt']))
        || hasModPerm('manageAds');
      allow delete: if (hasSessionIdentity() && resource.data.posterId == appUid())
        || hasModPerm('manageAds');
    }

    // ── Service Requests (P1-2 Fixed: قراءة مقصورة على صاحب الطلب ومزودي الخدمة والتجار والإدارة) ──
    match /service_requests/{reqId} {
      allow read: if hasSessionIdentity() && (
        resource.data.clientId == appUid()
        || isMerchant()
        || isServiceProvider()
        || isModerator()
      );
      allow create: if (hasSessionIdentity()
        && request.resource.data.clientId == appUid()
        && request.resource.data.id == reqId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200)
        || isAdmin();
      allow update: if (hasSessionIdentity()
          && resource.data.clientId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'clientId', 'createdAt', 'bidsCount']))
        || isModerator()
        || (hasSessionIdentity()
          && (isMerchant() || isServiceProvider())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidsCount'])
          && request.resource.data.bidsCount == resource.data.bidsCount + 1);
      allow delete: if (hasSessionIdentity() && resource.data.clientId == appUid())
        || isModerator();
    }

    // ── Service Bids (عروض الأسعار على طلبات الخدمة) ─────────────────────────
    match /service_bids/{bidId} {
      allow read: if hasSessionIdentity() && (
        resource.data.providerId == appUid()
        || serviceRequestData(resource.data.requestId).clientId == appUid()
        || isModerator()
      );
      allow create: if isModerator()
        || (hasSessionIdentity()
          && request.resource.data.keys().hasOnly(['id', 'requestId', 'providerId', 'providerName', 'providerPhone', 'offeredPrice', 'note', 'status', 'createdAt'])
          && request.resource.data.id == bidId
          && request.resource.data.providerId == appUid()
          && request.resource.data.status == 'pending'
          && request.resource.data.offeredPrice is number
          && request.resource.data.offeredPrice > 0
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId))
          && serviceRequestData(request.resource.data.requestId).status == 'open'
          && serviceRequestData(request.resource.data.requestId).clientId != appUid());
      allow update: if hasSessionIdentity()
        && serviceRequestData(resource.data.requestId).clientId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if (hasSessionIdentity() && resource.data.providerId == appUid()) || isModerator();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if (hasSessionIdentity() && resource.data.targetUserId == appUid()) || isModerator();
      allow create: if isModerator()
        || (hasSessionIdentity()
          && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'data', 'isRead', 'createdAt'])
          && request.resource.data.keys().hasAll(['title', 'body', 'type', 'targetUserId', 'fromUserId', 'isRead', 'createdAt'])
          && request.resource.data.fromUserId == appUid()
          && request.resource.data.targetUserId is string
          && request.resource.data.targetUserId.size() > 0
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 1000
          && request.resource.data.type is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt == request.time);
      allow update: if hasSessionIdentity()
        && resource.data.targetUserId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'inviteStatus']);
      allow delete: if (hasSessionIdentity() && resource.data.targetUserId == appUid()) || isModerator();
    }

    // ── Notification Queue (P0-4 Fixed: الإرسال يتم عبر Cloud Function فقط) ────
    match /notification_queue/{docId} {
      allow read, delete: if hasModPerm('manageSettings');
      allow create, update: if false;
    }

    // ── Wishlists (P1-3 Fixed: منع الانضمام الذاتي وتقييد المتعاونين بعناصر القائمة فقط) ──
    match /wishlists/{listId} {
      allow read: if hasSessionIdentity() && (
        resource.data.ownerId == appUid()
        || appUid() in resource.data.collaborators
        || resource.data.isPublic == true
      );
      allow create: if (hasSessionIdentity() && request.resource.data.ownerId == appUid()) || isAdmin();
      allow update: if hasSessionIdentity() && (
        (resource.data.ownerId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt']))
        || (appUid() in resource.data.collaborators
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']))
      );
      allow delete: if hasSessionIdentity() && resource.data.ownerId == appUid();
    }

    // ── Complaints ────────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow read: if (hasSessionIdentity() && resource.data.userId == appUid()) || hasModPerm('viewReports');
      allow create: if (hasSessionIdentity() && request.resource.data.userId == appUid()) || isAdmin();
      allow update, delete: if hasModPerm('viewReports');
    }

    // ── Dealer Listings (بيع المستعمل — P1-8 Fixed) ──────────────────────────
    match /dealer_listings/{listingId} {
      allow read: if true;
      allow create: if (hasSessionIdentity()
        && request.resource.data.sellerId == appUid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.get('isPaid', false) == false)
        || isAdmin();
      allow update: if (hasSessionIdentity()
          && resource.data.sellerId == appUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'sellerId', 'isPaid', 'feeCodeId', 'createdAt']))
        || hasModPerm('manageAds');
      allow delete: if (hasSessionIdentity() && resource.data.sellerId == appUid())
        || hasModPerm('manageAds');
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if hasModPerm('manageSettings');
    }

    // ── Settings Private (P0-8 Fixed: منع قراءة المفتاح السري من أي عميل) ──────
    match /settings_private/{docId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // ── Gemini Rate Limits (خاص بالخادم فقط) ──────────────────────────────────
    match /gemini_rate_limits/{userId} {
      allow read, write: if false;
    }

    // ── Admin Audit Log ───────────────────────────────────────────────────────
    match /admin_audit_log/{logId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.adminId == appUid()
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ── Service Providers (P1-8 Fixed) ────────────────────────────────────────
    match /service_providers/{providerId} {
      allow read: if true;
      allow create, update: if (hasSessionIdentity()
          && appUid() == providerId
          && request.resource.data.userId == appUid()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 150)
        || hasModPerm('manageShops');
      allow delete: if (hasSessionIdentity() && appUid() == providerId) || hasModPerm('manageShops');
    }

    // ── Referrals (P0-6 Fixed: كتابة حصرية عبر Cloud Function redeemReferralCode) ──
    match /referrals/{referralId} {
      allow read: if (hasSessionIdentity() && (
        resource.data.referrerId == appUid()
        || resource.data.get('referredId', '') == appUid()
        || resource.data.get('newUserId', '') == appUid()
      )) || hasModPerm('manageUsers');
      allow create, update, delete: if false;
    }

    // ── Share Analytics (نقرات روابط المشاركة) ─────────────────────────────────
    match /share_analytics/{eventId} {
      allow create: if hasSessionIdentity()
        && request.resource.data.keys().hasOnly(['type', 'targetId', 'clickedAt', 'platform'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 32
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 32
        && request.resource.data.clickedAt == request.time;
      allow read, update, delete: if isModerator();
    }

    // ── Job Subscriptions (اشتراك إشعارات الوظائف) ─────────────────────────────
    match /job_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // ── Provider Topic Subscriptions (اشتراك مزوّد الخدمة في مواضيع FCM) ─────────
    match /provider_topic_subscriptions/{userId} {
      allow read, delete: if isOwner(userId) || isModerator();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'categories', 'fcmTopics', 'updatedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.categories is list
        && request.resource.data.fcmTopics is list
        && request.resource.data.categories.size() <= 50
        && request.resource.data.fcmTopics.size() <= 50
        && request.resource.data.updatedAt == request.time;
    }

    // ── Collection Invites (دعوات القوائم المشتركة) ─────────────────────────────
    match /collection_invites/{inviteId} {
      allow read: if (hasSessionIdentity()
          && (resource.data.inviteeId == appUid() || resource.data.inviterId == appUid()))
        || isModerator();
      allow create: if hasSessionIdentity()
        && request.resource.data.keys().hasOnly(
            ['collectionId', 'collectionName', 'inviterId', 'inviterName', 'inviteeId', 'status', 'createdAt'])
        && request.resource.data.inviterId == appUid()
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if hasSessionIdentity()
        && resource.data.inviteeId == appUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if (hasSessionIdentity()
          && (resource.data.inviterId == appUid() || resource.data.inviteeId == appUid()))
        || isModerator();
    }
  }
}
