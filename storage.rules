rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }

    // ✅ Security Fix (P0): إغلاق الجلسات المجهولة ومنع انتحال الهوية عبر auth_sessions في الإنتاج
    function allowMockSessions() { return false; }

    function isAnonymousSession() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function sessionAllowed() {
      return isAuth() && (!isAnonymousSession() || allowMockSessions());
    }

    function appUid() {
      return request.auth.uid;
    }

    function hasIdentity() {
      return sessionAllowed();
    }

    function isOwner(uid) { return sessionAllowed() && appUid() == uid; }

    function isStaff() {
      return sessionAllowed()
        && firestore.get(/databases/(default)/documents/users/$(appUid())).data.userType in ['admin', 'super_admin', 'moderator'];
    }

    function isMerchantOrStaff() {
      return sessionAllowed()
        && firestore.get(/databases/(default)/documents/users/$(appUid())).data.userType in ['merchant', 'admin', 'super_admin', 'moderator'];
    }

    function canManageShopStorage(shopId) {
      return sessionAllowed() && (
        isStaff()
        || (firestore.exists(/databases/(default)/documents/shops/$(shopId))
            && firestore.get(/databases/(default)/documents/shops/$(shopId)).data.ownerId == appUid())
      );
    }

    // ✅ التحقق من ملكية الملف عبر customMetadata.ownerId عند الحذف أو الاستبدال، مع السماح للإدارة
    function isFileOwnerOrStaff() {
      return hasIdentity() && (
        (resource != null && resource.metadata != null && 'ownerId' in resource.metadata && resource.metadata.ownerId == appUid())
        || isStaff()
      );
    }

    function canWriteMerchantAsset() {
      return isMerchantOrStaff() && (
        resource == null
        || (resource.metadata != null && 'ownerId' in resource.metadata && resource.metadata.ownerId == appUid())
        || isStaff()
      );
    }

    function canDeleteMerchantAsset() {
      return isMerchantOrStaff() && (
        resource == null
        || resource.metadata == null
        || !('ownerId' in resource.metadata)
        || resource.metadata.ownerId == appUid()
        || isStaff()
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function maxImageSize() { return request.resource.size < 10 * 1024 * 1024; }
    function maxVideoSize() { return request.resource.size < 100 * 1024 * 1024; }
    function maxAvatarSize() { return request.resource.size < 3 * 1024 * 1024; }

    // ── صورة الملف الشخصي ───────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && maxAvatarSize();
      allow delete: if isOwner(userId) || isStaff();
    }

    // ── شعارات وأغلفة ووسائط المحل ──────────────────────────────────────────
    match /shops/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && (isImage() || isVideo()) && maxVideoSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_logos/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_covers/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_media/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_media_videos/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isVideo() && maxVideoSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور المنتجات (products و products_images) ───────────────────────────
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /products_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور العروض (offers و offers_images) ─────────────────────────────────
    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /offers_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور وفيديوهات الإعلانات التجارية ────────────────────────────────────
    match /ad_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /ads/{shopId}/pending/{allPaths=**} {
      allow read: if true;
      allow write: if canManageShopStorage(shopId) && isVideo() && maxVideoSize();
      allow delete: if canManageShopStorage(shopId);
    }

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && (isImage() || isVideo()) && maxVideoSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور التقييمات (reviews و reviews_images) ────────────────────────────
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    match /reviews_images/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    // ── صور إعلانات سنهور ديلر ─────────────────────────────────────────────
    match /dealer_listings/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    // ── مرفقات الشكاوى ──────────────────────────────────────────────────────
    match /complaint_attachments/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId) && isImage() && maxImageSize();
      allow delete: if isOwner(userId) || isStaff();
    }

    // ── Fallback: رفض الكتابة في أي مسار غير معرّف ──────────────────────────
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
