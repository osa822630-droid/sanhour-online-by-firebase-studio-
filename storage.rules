rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }

    function isAnonymousSession() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isBuiltInSuperAdminEmail() {
      return isAuth()
        && ('email' in request.auth.token)
        && request.auth.token.email in [
          'u201008908728@users.sanhour.online',
          'u01008908728@users.sanhour.online',
          'admin@sanhour.com',
          'admin@sanhour.online'
        ];
    }

    function isNotSuspendedOrDeleted() {
      return isBuiltInSuperAdminEmail()
        || !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        || (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isSuspended', false) != true
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isDeleted', false) != true
        );
    }

    // ✅ F-005 Fix: منع الحسابات الموقوفة والمحذوفة والجلسات المجهولة
    function sessionAllowed() {
      return isAuth() && !isAnonymousSession() && isNotSuspendedOrDeleted();
    }

    function appUid() {
      return request.auth.uid;
    }

    function hasIdentity() {
      return sessionAllowed();
    }

    function isOwner(uid) { return sessionAllowed() && appUid() == uid; }

    function tokenRole() {
      return ('userType' in request.auth.token && request.auth.token.userType is string)
        ? request.auth.token.userType
        : (('role' in request.auth.token && request.auth.token.role is string)
            ? request.auth.token.role
            : '');
    }

    function firestoreRole() {
      return firestore.exists(/databases/(default)/documents/users/$(appUid()))
        ? firestore.get(/databases/(default)/documents/users/$(appUid())).data.get('userType', '')
        : '';
    }

    // ✅ F-005 Fix: أولوية دور Firestore على Custom Claims القديمة مع دعم السوبر أدمن الأساسي
    function effectiveRole() {
      return isBuiltInSuperAdminEmail()
        ? 'super_admin'
        : (!sessionAllowed()
            ? ''
            : (firestoreRole() != '' ? firestoreRole() : tokenRole()));
    }

    function isStaff() {
      return sessionAllowed()
        && effectiveRole() in ['admin', 'super_admin', 'moderator'];
    }

    function isMerchantOrStaff() {
      return sessionAllowed() && (
        effectiveRole() in ['merchant', 'admin', 'super_admin', 'moderator']
        || (firestore.exists(/databases/(default)/documents/users/$(appUid()))
            && firestore.get(/databases/(default)/documents/users/$(appUid())).data.get('businessType', '') in ['pending_merchant', 'shop', 'service_provider'])
      );
    }

    function canManageShopStorage(shopId) {
      return sessionAllowed() && (
        isStaff()
        || (firestore.exists(/databases/(default)/documents/shops/$(shopId))
            && firestore.get(/databases/(default)/documents/shops/$(shopId)).data.ownerId == appUid())
        || (firestore.exists(/databases/(default)/documents/users/$(appUid()))
            && firestore.get(/databases/(default)/documents/users/$(appUid())).data.linkedShopId == shopId
            && firestore.get(/databases/(default)/documents/users/$(appUid())).data.shopRole in ['owner', 'partner', 'worker'])
      );
    }

    // ✅ إلزام إرفاق ownerId في customMetadata مطابقاً لـ appUid() عند الرفع
    function hasValidUploadOwner() {
      return request.resource != null
        && request.resource.metadata != null
        && 'ownerId' in request.resource.metadata
        && request.resource.metadata['ownerId'] == appUid();
    }

    // ✅ التحقق الصارم من ملكية الملف عند الحذف أو الاستبدال
    function isFileOwnerOrStaff() {
      return hasIdentity() && (
        (resource != null && resource.metadata != null && 'ownerId' in resource.metadata && resource.metadata['ownerId'] == appUid())
        || isStaff()
      );
    }

    function canWriteMerchantAsset() {
      return isMerchantOrStaff()
        && hasValidUploadOwner()
        && (resource == null || isFileOwnerOrStaff())
        && (
          !('shopId' in request.resource.metadata)
          || request.resource.metadata['shopId'] == ''
          || canManageShopStorage(request.resource.metadata['shopId'])
        );
    }

    function canDeleteMerchantAsset() {
      return isMerchantOrStaff() && isFileOwnerOrStaff();
    }

    // ✅ F-046 Fix: منع رفع ملفات SVG القابلة لتنفيذ XSS وقبول صيغ الصور النقطية الآمنة فقط
    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    function isVideo() {
      return request.resource != null
        && request.resource.contentType.matches('video/(mp4|quicktime|webm|x-matroska|3gpp)');
    }

    function maxImageSize() { return request.resource != null && request.resource.size < 10 * 1024 * 1024; }
    function maxVideoSize() { return request.resource != null && request.resource.size < 100 * 1024 * 1024; }
    function maxAvatarSize() { return request.resource != null && request.resource.size < 3 * 1024 * 1024; }

    // ── صورة الملف الشخصي ───────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && maxAvatarSize();
      allow delete: if isOwner(userId) || isStaff();
    }

    // ── شعارات وأغلفة ووسائط المحل المقيدة بمعرّف المحل ─────────────────────
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if canManageShopStorage(shopId) && hasValidUploadOwner() && (isImage() || isVideo()) && maxVideoSize();
      allow delete: if canManageShopStorage(shopId) && isFileOwnerOrStaff();
    }

    match /shop_logos/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_covers/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_media/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /shop_media_videos/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isVideo() && maxVideoSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور المنتجات (products و products_images) ───────────────────────────
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /products_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور العروض (offers و offers_images) ─────────────────────────────────
    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /offers_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور وفيديوهات الإعلانات التجارية ────────────────────────────────────
    match /ad_images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && isImage() && maxImageSize();
      allow delete: if canDeleteMerchantAsset();
    }

    match /ads/{shopId}/pending/{allPaths=**} {
      allow read: if true;
      allow write: if canManageShopStorage(shopId) && hasValidUploadOwner() && isVideo() && maxVideoSize();
      allow delete: if canManageShopStorage(shopId) && isFileOwnerOrStaff();
    }

    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteMerchantAsset() && (isImage() || isVideo()) && maxVideoSize();
      allow delete: if canDeleteMerchantAsset();
    }

    // ── صور التقييمات (reviews و reviews_images — F-047 & F-048 Fixed) ───────
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && hasValidUploadOwner() && (resource == null || isFileOwnerOrStaff()) && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    match /reviews_images/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && hasValidUploadOwner() && (resource == null || isFileOwnerOrStaff()) && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    // ── صور إعلانات سنهور ديلر (F-047 & F-048 Fixed) ────────────────────────
    match /dealer_listings/{allPaths=**} {
      allow read: if true;
      allow write: if hasIdentity() && hasValidUploadOwner() && (resource == null || isFileOwnerOrStaff()) && isImage() && maxImageSize();
      allow delete: if isFileOwnerOrStaff();
    }

    // ── مرفقات الشكاوى (قراءة خاصة لصاحب الشكوى والإدارة فقط — P0-7 Fixed) ──
    match /complaint_attachments/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId) && isImage() && maxImageSize();
      allow delete: if isOwner(userId) || isStaff();
    }

    // ── Fallback: إغلاق القراءة والكتابة لأي مسار غير معرّف ──────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
